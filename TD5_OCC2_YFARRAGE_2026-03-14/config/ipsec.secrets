# /etc/ipsec.secrets — siteA-gw (Azure) and siteB-gw (AWS)
#
# Cloud adaptation: identifiers use PUBLIC IPs (not WAN private IPs)
# because both gateways are behind NAT (Azure SNAT + AWS Elastic IP).
# strongSwan uses leftid/rightid=public IPs in ipsec.conf, so the PSK
# must match those same identifiers here.
#
# PSK REDACTED before submission — never commit secrets to a repo.
#
# siteA-gw (pip-gw-fw-wan) <-> siteB-gw (Elastic IP)
98.66.160.46 35.181.66.138 : PSK "<REDACTED>"

